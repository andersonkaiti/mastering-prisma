generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String?   @unique
  birthdate DateTime?
  isActive  Boolean   @default(true) @map("is_active")

  @@index([name])
  @@map("users")
}
