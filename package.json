{
  "name": "mastering-prisma",
  "type": "module",
  "main": "src/infra/http/server.ts",
  "scripts": {
    "dev": "tsx watch --env-file=.env .",
    "prepare": "husky"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "commitlint-config-gitmoji": "^2.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional",
      "gitmoji"
    ],
    "rules": {
      "scope-empty": [
        2,
        "never"
      ]
    }
  },
  "lint-staged": {
    "**/*.{json,ts}": [
      "biome check --write"
    ]
  }
}
